FROM postgis/postgis:16-3.4

USER root

# Repositorio historico de PostgreSQL
RUN find /etc/apt/sources.list.d -type f \
    -exec sed -i \
    's|apt.postgresql.org|apt-archive.postgresql.org|g' {} +

# Repositorio historico de seguridad Debian 11
RUN sed -i \
    -e 's|http://deb.debian.org/debian-security|https://archive.debian.org/debian-security|g' \
    -e 's|http://security.debian.org/debian-security|https://archive.debian.org/debian-security|g' \
    /etc/apt/sources.list

# Eliminar indices antiguos e instalar GDAL
RUN rm -rf /var/lib/apt/lists/* && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends \
        gdal-bin \
        python3-gdal && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER postgres